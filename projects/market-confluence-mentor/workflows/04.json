          "name": "Mentor local key"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mentor-journal",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "mentor-journal-v1-webhook",
