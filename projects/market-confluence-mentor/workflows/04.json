      "name": "Request body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        230
      ]
    },
    {
      "parameters": {
        "jsCode": "const allowed=['entry','outcome','performance','journal','status','report']; if(!allowed.includes($json.operation)) throw new Error('Unsupported journal operation'); if(!$json.payload || typeof $json.payload !== 'object' || Array.isArray($json.payload)) throw new Error('Object payload required'); return [{json:$json}];"
      },
      "id": "journal-allow",
      "name": "Allowed journal action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        0
      ]
    }
